/* The stack_guard for `stack-protector` mitigation - https://doc.rust-lang.org/rustc/exploit-mitigations.html#stack-smashing-protection */
__stack_chk_guard = ABSOLUTE(_stack_end) + ${ESP_HAL_CONFIG_STACK_GUARD_OFFSET};

ASSERT(_stack_start - _stack_end >= ${ESP_HAL_CONFIG_ENSURE_MAIN_STACK_MINIMUM}, "Main stack is smaller than ${ESP_HAL_CONFIG_ENSURE_MAIN_STACK_MINIMUM} bytes.");

#IF esp32
/* reserved at the start of DRAM for the BT stack */
#IF CARGO_FEATURE("__bluetooth")
ESP_HAL_BT_RESERVED_DRAM = 0x10000;
#ELSE
ESP_HAL_BT_RESERVED_DRAM = 0;
#ENDIF
#ENDIF

/* RAM used as cache, in bytes */
#IF esp32s2 || esp32s3
#IF ESP_HAL_CONFIG_INSTRUCTION_CACHE_SIZE == "8KB"
ESP_HAL_INSTRUCTION_CACHE_SIZE = 0x2000;
#ELSE IF ESP_HAL_CONFIG_INSTRUCTION_CACHE_SIZE == "16KB"
ESP_HAL_INSTRUCTION_CACHE_SIZE = 0x4000;
#ELSE IF ESP_HAL_CONFIG_INSTRUCTION_CACHE_SIZE == "32KB"
ESP_HAL_INSTRUCTION_CACHE_SIZE = 0x8000;
#ENDIF

#IF ESP_HAL_CONFIG_DATA_CACHE_SIZE == "0KB"
ESP_HAL_DATA_CACHE_SIZE = 0;
#ELSE IF ESP_HAL_CONFIG_DATA_CACHE_SIZE == "8KB"
ESP_HAL_DATA_CACHE_SIZE = 0x2000;
#ELSE IF ESP_HAL_CONFIG_DATA_CACHE_SIZE == "16KB"
ESP_HAL_DATA_CACHE_SIZE = 0x4000;
#ELSE IF ESP_HAL_CONFIG_DATA_CACHE_SIZE == "32KB"
ESP_HAL_DATA_CACHE_SIZE = 0x8000;
#ELSE IF ESP_HAL_CONFIG_DATA_CACHE_SIZE == "64KB"
ESP_HAL_DATA_CACHE_SIZE = 0x10000;
#ENDIF
#ENDIF

#IF esp32p4
#IF ESP_HAL_CONFIG_L2_CACHE_SIZE == "512KB"
ESP_HAL_L2_CACHE_SIZE = 0x80000;
#ELSE IF ESP_HAL_CONFIG_L2_CACHE_SIZE == "256KB"
ESP_HAL_L2_CACHE_SIZE = 0x40000;
#ELSE IF ESP_HAL_CONFIG_L2_CACHE_SIZE == "128KB"
ESP_HAL_L2_CACHE_SIZE = 0x20000;
#ELSE IF ESP_HAL_CONFIG_L2_CACHE_SIZE == "0KB"
ESP_HAL_L2_CACHE_SIZE = 0;
#ENDIF
#ENDIF
