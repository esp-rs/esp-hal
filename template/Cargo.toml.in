[package]
name = "{{ project_name }}"
version = "0.1.0"
edition = "2024"
rust-version = "1.95"

[[bin]]
name = "{{ project_name }}"
path = "./src/bin/main.rs"
#%if option("embedded-test")
test = false

[[test]]
name    = "hello_test"
harness = false

[lib]
test = false
#%endif

[dependencies]
#%if option("defmt")
#+defmt = "1.0.1"
#%else if option("log")
log = "0.4.27"
#%endif

#%if option("probe-rs")
#%if option("defmt")
rtt-target = { version = "0.6.2", features = ["defmt"] }
#%else
#+rtt-target = "0.6.2"
#%endif defmt
#%endif probe-rs
#%if option("panic-rtt-target")
#%if option("defmt")
#+panic-rtt-target = { version = "0.2.0", features = ["defmt"] }
#%else
panic-rtt-target = "0.2.0"
#%endif defmt
#%endif panic-rtt-target
#%if option("wifi") || option("ble-trouble")
#%if option("defmt")
#+embedded-io = { version = "0.7.1", features = ["defmt"] }
#%else
embedded-io = "0.7.1"
#%endif defmt
#%if option("embassy")
#%if option("defmt")
#+embedded-io-async = { version = "0.7.0", features = ["defmt"] }
#%else
embedded-io-async = "0.7.0"
#%endif defmt
#%if option("wifi")
embassy-net = { version = "0.9.1", features = [
    "tcp",
    "udp",
    "dhcpv4",
    "medium-ethernet",
    #%if option("defmt")
    #+    "defmt",
    #%endif
    #%if option("log")
    "log",
    #%endif
] }
# for more networking protocol support see https://crates.io/crates/edge-net
#%endif wifi
#%endif embassy
#%if option("wifi")
smoltcp = { version = "0.14.0", default-features = false, features = [
    "medium-ethernet",
    "multicast",
    "proto-dhcpv4",
    "proto-dns",
    "proto-ipv4",
    "socket-dns",
    "socket-raw",
    "socket-tcp",
    "socket-udp",
    "socket-icmp",
    #%if option("defmt")
    #+    "defmt",
    #%endif
    #%if option("log")
    "log",
    #%endif
] }
#%endif wifi
#%if option("ble-trouble")
trouble-host = { version = "0.8.0", features = [
    "default-packet-pool-mtu-255",
    "derive",
    "gatt",
    "scan",
    #%if option("defmt")
    #+    "defmt",
    #%endif
    #%if option("log")
    "log",
    #%endif
] }
#%endif
#%endif wifi || ble-trouble
#%if option("embassy")
embassy-executor = { version = "0.10.0", features = [
    #%if option("defmt")
    #+    "defmt",
    #%endif
    #%if option("log")
    "log",
    #%endif
] }
#%if option("defmt")
#+embassy-time     = { version = "0.5.0", features = ["defmt"] }
#%endif
#%if option("log")
embassy-time = { version = "0.5.0", features = ["log"] }
#%endif
#%if !option("defmt") && !option("log")
#+embassy-time     = "0.5.0"
#%endif

static_cell = "2.1.1"
#%endif
critical-section = "1.2.0"

# The Espressif crates come from this esp-hal repository: a path into the
# checkout the project was generated from, or the commit it was cloned at.

[dependencies.esp-hal]
#%if template_origin == "repository"
path = "{{ template_repo }}/esp-hal"
#%else
#+git = "{{ template_url }}"
#+rev = "{{ template_commit }}"
#%endif
features = [
    "{{ chip.name }}",
    #%if option("unstable-hal")
    "unstable",
    #%endif
    #%if option("defmt")
    #+    "defmt",
    #%endif
    #%if option("log")
    "log-04",
    #%endif
]

[dependencies.esp-bootloader-esp-idf]
#%if template_origin == "repository"
path = "{{ template_repo }}/esp-bootloader-esp-idf"
#%else
#+git = "{{ template_url }}"
#+rev = "{{ template_commit }}"
#%endif
features = [
    "{{ chip.name }}",
    #%if option("defmt")
    #+    "defmt",
    #%endif
    #%if option("log")
    "log-04",
    #%endif
]

#%if !option("probe-rs") && (group_selected("log-frontend") || group_selected("panic-handler"))
[dependencies.esp-println]
#%if template_origin == "repository"
path = "{{ template_repo }}/esp-println"
#%else
#+git = "{{ template_url }}"
#+rev = "{{ template_commit }}"
#%endif
features = [
    "{{ chip.name }}",
    #%if option("defmt")
    #+    "defmt-espflash",
    #%endif
    #%if option("log")
    "log-04",
    #%endif
]
#%endif esp-println

#%if option("esp-backtrace")
[dependencies.esp-backtrace]
#%if template_origin == "repository"
path = "{{ template_repo }}/esp-backtrace"
#%else
#+git = "{{ template_url }}"
#+rev = "{{ template_commit }}"
#%endif
features = [
    "{{ chip.name }}",
    "panic-handler",
    #%if option("defmt")
    #+    "defmt",
    #%else
    "println",
    #%endif
]
#%endif esp-backtrace

#%if option("alloc")
[dependencies.esp-alloc]
#%if template_origin == "repository"
path = "{{ template_repo }}/esp-alloc"
#%else
#+git = "{{ template_url }}"
#+rev = "{{ template_commit }}"
#%endif
features = [
    "{{ chip.name }}",
    #%if option("defmt")
    #+    "defmt",
    #%endif
]
#%endif alloc

#%if option("embassy") || option("wifi") || option("ble-trouble")
[dependencies.esp-rtos]
#%if template_origin == "repository"
path = "{{ template_repo }}/esp-rtos"
#%else
#+git = "{{ template_url }}"
#+rev = "{{ template_commit }}"
#%endif
features = [
    "{{ chip.name }}",
    #%if option("embassy")
    "embassy",
    #%endif
    #%if option("wifi") || option("ble-trouble")
    "esp-radio",
    #%endif
    #%if option("alloc")
    "esp-alloc",
    #%endif
    #%if option("defmt")
    #+    "defmt",
    #%endif
    #%if option("log")
    "log-04",
    #%endif
]
#%endif esp-rtos

#%if option("wifi") || option("ble-trouble")
[dependencies.esp-radio]
#%if template_origin == "repository"
path = "{{ template_repo }}/esp-radio"
#%else
#+git = "{{ template_url }}"
#+rev = "{{ template_commit }}"
#%endif
features = [
    "{{ chip.name }}",
    #%if option("wifi")
    "wifi",
    #%endif
    #%if option("ble-trouble")
    "ble",
    #%endif
    #%if option("wifi") && option("ble-trouble")
    "coex",
    #%endif
    #%if option("alloc")
    "esp-alloc",
    #%endif
    "unstable",
    #%if option("defmt")
    #+    "defmt",
    #%endif
    #%if option("log")
    "log-04",
    #%endif
]
#%endif esp-radio

#%if option("embedded-test")
[dev-dependencies]
embedded-test = { version = "0.7.1", features = [
    #%if chip.xtensa
    "xtensa-semihosting",
    #%endif
    #%if option("embassy")
    "embassy-010",
    "external-executor",
    #%endif
    #%if option("defmt")
    #+    "defmt",
    #%endif
    #%if option("log")
    "log-04",
    #%endif
] }
#%endif embedded-test

# For fine tuning these settings, please refer to https://doc.rust-lang.org/cargo/reference/profiles.html
[profile.dev]
# The default debug profile is too slow and too big for resource-constrained devices.
# Always build with some optimizations enabled.
opt-level = "s"

[profile.release]
codegen-units = 1       # LLVM can perform better optimizations using a single thread
debug = 2               # prefer slower builds but better debugging experience
lto = 'fat'
opt-level = 's'
